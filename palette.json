{
  "$schema": "./palette.schema.json",
  "meta": {
    "name": "RBR",
    "description": "A Red Bull Racing inspired color scheme. Kerb red × RB yellow on deep navy, with a pastel supporting cast.",
    "version": "2.1.0",
    "license": "MIT",
    "principles": [
      "Kerb Red (#e84a55) is the PRIMARY accent: 'this is the selected/active thing' — exactly one per viewport.",
      "RB Yellow (#ffd84d) is the SECONDARY accent: 'attention needed now' — cursor, warnings, notifications.",
      "All other accents stay pastel so the brand pair always wins the eye.",
      "Deep navy base keeps red and yellow readable without harshness."
    ]
  },

